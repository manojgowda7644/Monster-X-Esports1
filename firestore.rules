rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles: Only the authenticated user can read or modify their own document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;
    }

    // Public tournament announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if false;
    }

    // Test connection doc for validation
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }
  }
}
